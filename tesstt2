# 3️⃣ CHANGE #3: Add inference logger (NEW FUNCTION)

Add this in `registry.py` or new `inference.py`

```python
def run_inference(df, model, scaler, features, medians, user):
    run_id = get_run_id()
    
    try:
        log_event(run_id, "FEATURE_ENGINEERING_START", user)
        X = df[features].fillna(medians)
        
        log_event(run_id, "SCALING", user)
        X_scaled = scaler.transform(X)
        
        log_event(run_id, "PREDICTION", user)
        preds = model.predict(X_scaled)
        
        log_event(run_id, "SUCCESS", user, {"rows": len(preds)})
        return preds
    
    except Exception as e:
        log_event(
            run_id, "ERROR", user,
            {"error": str(e), "file": __file__},
            level="ERROR"
        )
        raise
```

